export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export EDITOR="${EDITOR:-vim}"

typeset -U path PATH
path=(/opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/.grok/bin" "$HOME/.lmstudio/bin" $path)

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt append_history
setopt auto_cd
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt share_history

autoload -Uz compinit
compinit

typeset -g DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
if [[ ! -d "$DOTFILES_DIR" ]]; then
  DOTFILES_DIR="${${(%):-%N}:A:h:h}"
fi

for config in "$DOTFILES_DIR"/zsh/*.zsh(N); do
  source "$config"
done

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if [[ -r /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  source /opt/homebrew/opt/fzf/shell/completion.zsh
elif [[ -r /usr/local/opt/fzf/shell/key-bindings.zsh ]]; then
  source /usr/local/opt/fzf/shell/key-bindings.zsh
  source /usr/local/opt/fzf/shell/completion.zsh
fi

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
