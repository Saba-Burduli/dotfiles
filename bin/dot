#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done

PACKAGE_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
DOTFILES_DIR="$PACKAGE_DIR" exec "$PACKAGE_DIR/script/dot" "$@"
