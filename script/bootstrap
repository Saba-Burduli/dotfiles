#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="${DOTFILES_BACKUP_DIR:-$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)}"
DRY_RUN=0

usage() {
  cat <<'USAGE'
Usage: script/bootstrap [--dry-run]

Link versioned dotfiles into the current user's home directory.
Existing targets are moved into ~/.dotfiles-backup before linking.
USAGE
}

for argument in "$@"; do
  case "$argument" in
    --dry-run) DRY_RUN=1 ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$argument" >&2; usage >&2; exit 2 ;;
  esac
done

link_item() {
  local source="$1"
  local target="$2"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    printf 'ok      %s\n' "$target"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    printf 'backup  %s -> %s/\n' "$target" "$BACKUP_DIR"
    if [[ "$DRY_RUN" -eq 0 ]]; then
      mkdir -p "$BACKUP_DIR"
      mv "$target" "$BACKUP_DIR/$(basename "$target")"
    fi
  fi

  printf 'link    %s -> %s\n' "$target" "$source"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
  fi
}

link_item "$DOTFILES_DIR/git/gitconfig.symlink" "$HOME/.gitconfig"
link_item "$DOTFILES_DIR/git/gitignore.symlink" "$HOME/.gitignore_global"
link_item "$DOTFILES_DIR/zsh/zshrc.symlink" "$HOME/.zshrc"
link_item "$DOTFILES_DIR/keybindings" "$HOME/.config/keybindings"

if [[ "$DRY_RUN" -eq 1 ]]; then
  printf '\nDry run complete; no files were changed.\n'
else
  printf '\nDotfiles installed. Restart the shell to load the new configuration.\n'
fi
