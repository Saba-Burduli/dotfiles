#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bash -n "$DOTFILES_DIR/script/bootstrap" "$DOTFILES_DIR/script/dot" "$DOTFILES_DIR/script/macos"

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck "$DOTFILES_DIR/script/bootstrap" "$DOTFILES_DIR/script/dot" "$DOTFILES_DIR/script/macos"
else
  printf 'Skipping shellcheck; install it with `dot packages`.\n'
fi

for manifest in "$DOTFILES_DIR"/manifest/*.tsv; do
  awk -F '\t' 'NF && $1 !~ /^#/ && NF != 2 { exit 1 }' "$manifest" || {
    printf 'Invalid manifest: %s\n' "$manifest" >&2
    exit 1
  }
done

ruby -c "$DOTFILES_DIR/Brewfile" >/dev/null
ruby -c "$DOTFILES_DIR/Formula/saba-dotfiles.rb" >/dev/null
ruby -rjson -e 'package = JSON.parse(File.read(ARGV.fetch(0))); abort "wrong package name" unless package.fetch("name") == "@saba-burduli/dotfiles"; abort "wrong bin" unless package.fetch("bin").fetch("dot") == "bin/dot"' "$DOTFILES_DIR/package.json"
[[ -x "$DOTFILES_DIR/bin/dot" ]] || { printf 'Package executable is not executable.\n' >&2; exit 1; }

while IFS=$'\t' read -r source relative_target; do
  [[ -z "$source" || "${source:0:1}" == '#' ]] && continue
  [[ -e "$DOTFILES_DIR/$source" ]] || { printf 'Missing managed source: %s\n' "$source" >&2; exit 1; }
done < "$DOTFILES_DIR/manifest/links.tsv"

if rg -n -i '(auth\.json|hosts\.yml|ghp_|sk-[a-z0-9]{16}|authorization[[:space:]]*=|api[_-]?key[[:space:]]*=|password[[:space:]]*=|private[ _-]?key)' "$DOTFILES_DIR/config"; then
  printf 'Potential secret or excluded state found in config/.\n' >&2
  exit 1
fi

for pin in 'node = "26.5.0"' 'python = "3.14.6"' 'go = "1.26.2"' 'dotnet = "10.0.203"'; do
  rg -Fqx "$pin" "$DOTFILES_DIR/mise.toml" || {
    printf 'Missing mise pin: %s\n' "$pin" >&2
    exit 1
  }
done

rg -Fqx 'brew "mise"' "$DOTFILES_DIR/Brewfile"
rg -Fqx 'brew "shellcheck"' "$DOTFILES_DIR/Brewfile"
rg -Fqx 'brew "gitleaks"' "$DOTFILES_DIR/Brewfile"

while IFS=$'\t' read -r plugin state; do
  [[ -z "$plugin" || "${plugin:0:1}" == '#' ]] && continue
  expected=false
  [[ "$state" == enabled ]] && expected=true
  awk -v plugin="$plugin" -v expected="$expected" '
    $0 == "[plugins.\"" plugin "\"]" { getline; if ($0 == "enabled = " expected) found=1 }
    END { exit !found }
  ' "$DOTFILES_DIR/config/codex/config.toml" || {
    printf 'Codex plugin state missing from config: %s (%s)\n' "$plugin" "$state" >&2
    exit 1
  }
done < "$DOTFILES_DIR/manifest/codex-plugins.tsv"

for expected in \
  'com.apple.dock|tilesize|int|42' \
  'com.apple.dock|show-recents|bool|false' \
  'com.apple.dock|autohide|bool|false' \
  'com.apple.finder|FXPreferredViewStyle|string|icnv' \
  'NSGlobalDomain|ApplePressAndHoldEnabled|bool|false' \
  'com.apple.desktopservices|DSDontWriteUSBStores|bool|true'; do
  rg -Fqx "  '$expected'" "$DOTFILES_DIR/script/macos" || {
    printf 'Missing reviewed macOS preference: %s\n' "$expected" >&2
    exit 1
  }
done

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --no-git --source "$DOTFILES_DIR" --redact --no-banner
else
  printf 'Skipping gitleaks; install it with `dot packages`.\n'
fi

app_count="$({ find "$DOTFILES_DIR/keybindings" -maxdepth 1 -type f -name '*.md' ! -name README.md; } | wc -l | tr -d ' ')"
binding_count="$(awk '/^\| `.*` \|/ { count++ } END { print count + 0 }' "$DOTFILES_DIR"/keybindings/*.md)"

if [[ "$app_count" -ne 13 ]]; then
  printf 'Expected 13 application files, found %s.\n' "$app_count" >&2
  exit 1
fi

if [[ "$binding_count" -ne 224 ]]; then
  printf 'Expected 224 keybindings, found %s.\n' "$binding_count" >&2
  exit 1
fi

printf 'Validated %s keybindings across %s application files.\n' "$binding_count" "$app_count"
