#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bash -n "$DOTFILES_DIR/script/bootstrap" "$DOTFILES_DIR/script/dot"

for manifest in "$DOTFILES_DIR"/manifest/*.tsv; do
  awk -F '\t' 'NF && $1 !~ /^#/ && NF != 2 { exit 1 }' "$manifest" || {
    printf 'Invalid manifest: %s\n' "$manifest" >&2
    exit 1
  }
done

while IFS=$'\t' read -r source relative_target; do
  [[ -z "$source" || "${source:0:1}" == '#' ]] && continue
  [[ -e "$DOTFILES_DIR/$source" ]] || { printf 'Missing managed source: %s\n' "$source" >&2; exit 1; }
done < "$DOTFILES_DIR/manifest/links.tsv"

if rg -n -i '(auth\.json|hosts\.yml|ghp_|sk-[a-z0-9]{16}|authorization[[:space:]]*=|api[_-]?key[[:space:]]*=|password[[:space:]]*=|private[ _-]?key)' "$DOTFILES_DIR/config"; then
  printf 'Potential secret or excluded state found in config/.\n' >&2
  exit 1
fi

for pin in 'node = "26.5.0"' 'python = "3.14.6"' 'go = "1.26.2"' 'dotnet = "10.0.203"'; do
  rg -Fqx "$pin" "$DOTFILES_DIR/mise.toml" || {
    printf 'Missing mise pin: %s\n' "$pin" >&2
    exit 1
  }
done

rg -Fqx 'brew "mise"' "$DOTFILES_DIR/Brewfile"
rg -Fqx 'brew "shellcheck"' "$DOTFILES_DIR/Brewfile"
rg -Fqx 'brew "gitleaks"' "$DOTFILES_DIR/Brewfile"

app_count="$({ find "$DOTFILES_DIR/keybindings" -maxdepth 1 -type f -name '*.md' ! -name README.md; } | wc -l | tr -d ' ')"
binding_count="$(awk '/^\| `.*` \|/ { count++ } END { print count + 0 }' "$DOTFILES_DIR"/keybindings/*.md)"

if [[ "$app_count" -ne 13 ]]; then
  printf 'Expected 13 application files, found %s.\n' "$app_count" >&2
  exit 1
fi

if [[ "$binding_count" -ne 224 ]]; then
  printf 'Expected 224 keybindings, found %s.\n' "$binding_count" >&2
  exit 1
fi

printf 'Validated %s keybindings across %s application files.\n' "$binding_count" "$app_count"
